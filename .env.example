# Your Daily.co API key — server-side only, never exposed to any professional's browser
DAILY_API_KEY=your_daily_api_key_here

# Supabase project (find both in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe prices and the optional founders coupon (see README / Stripe dashboard)
# STRIPE_PRICE_ID is the Unlimited price ($59/month); STRIPE_PRICE_ID_STARTER is the $10/month Starter price.
STRIPE_PRICE_ID=price_unlimited_here
STRIPE_PRICE_ID_STARTER=price_starter_here
# $20 off for 12 months, limited to 100 redemptions. Leave blank to turn the founders offer off.
STRIPE_FOUNDERS_COUPON_ID=
